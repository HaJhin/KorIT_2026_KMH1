<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--  namespace : 현재 Mapper XML이 어떤 Java 인터페이스와 연결되는지 지정 -->
<mapper namespace="com.korea.product.dao.OrdersDAO"> 
	<select id="findAll" resultType="OrdersVO">
		SELECT 
			o.order_id,
			o.product_id,
			p.product_name,
			p.product_price,
			o.product_count,
			p.product_price * 
	</select>
	
	<!-- 상품 추가 -->
	<insert id="createOrders">
		INSERT INTO orders(product_id,product_count) VALUES(#{productId},#{orderCount})
	</insert>
	
	<update id="decreaseStock">
		update product set
			product_stock = #{productStock}
		where product_id = #{productId}
	</update>
	
</mapper>