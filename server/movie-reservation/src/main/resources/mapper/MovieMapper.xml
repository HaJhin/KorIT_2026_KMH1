<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.korea.movie_reservation.dao.MovieDAO">

	<insert id="insertMovie">
		INSERT INTO movie(movie_title,movie_genre,running_time,ticket_price) 
		VALUES(#{movieTitle},#{movieGenre},#{runningTime},#{ticketPrice})
	</insert>
	
	<select id="findByMovieId" resultType="MovieVO">
		select * from movie where movie_id = #{movieId}
	</select>
	
	
</mapper>